# ===============================================
# Environment Variables Template (.env.example)
# Copy this file to .env and adjust your secrets
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT!
# ===============================================

# Django Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<YOUR_WORKER_PUBLIC_OR_PRIVATE_IP>

# Database Configuration (MySQL)
DB_HOST=db
DB_PORT=3306
DB_NAME=hotel_db
DB_USER=hotel_user
DB_PASSWORD=your_secure_db_password
MYSQL_ROOT_PASSWORD=your_secure_root_password

# Wazuh SIEM Configuration (Optional / Agent Reference)
WAZUH_MANAGER_IP=your_wazuh_manager_private_ip
WAZUH_AGENT_NAME=worker-node-1
